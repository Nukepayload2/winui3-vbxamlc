<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Offline shadow: clears the WinUI repo-root NuGet.config (which redirects globalPackagesFolder
       to the repo "packages" folder and adds remote feeds). With no sources and no globalPackagesFolder
       override, NuGet restores purely from the default user global cache (~/.nuget/packages), so the
       build is fully offline. Mirrors tmp\p0-3\NuGet.config. -->
  <config>
    <clear />
  </config>
  <packageSources>
    <clear />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
